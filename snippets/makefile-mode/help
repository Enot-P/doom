# -*- mode: snippet -*-
# name: Makefile help target for migrations
# key: help
# expand-env: ((yas-indent-line 'fixed))
# --
help:
	@echo "=== Доступные команды для миграций ==="
	@awk 'BEGIN {FS = ":.*##";} /^[a-zA-Z_-]+:.*?##/ {printf "  \033[36m%-20s\033[0m %s\n", \$\$1, \$\$2}' \$(MAKEFILE_LIST)
$0
